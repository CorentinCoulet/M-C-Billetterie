{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "billetterie-nextjs",
  "version": "1.2.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.0"
  },
  "scripts": {
    "_comment_yarn": "=== Yarn Management ===",
    "preinstall": "node -e \"if(process.env.npm_execpath && process.env.npm_execpath.indexOf('yarn') === -1) throw new Error('Use Yarn for this project: yarn install')\"",
    "_comment_dev": "=== Développement ===",
    "dev": "next dev",
    "dev:docker": "next dev --hostname 0.0.0.0 --port 3001",
    "dev:turbo": "next dev --turbo",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev",
    "_comment_build": "=== Build et Production ===",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "_comment_database": "=== Base de données ===",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:clean": "tsx prisma/seed.ts clean",
    "db:reset": "tsx prisma/seed.ts reset",
    "_comment_test": "=== Tests ===",
    "test": "jest",
    "test:all": "node scripts/run-all-tests.js",
    "test:all:ci": "jest --ci --coverage --watchAll=false && playwright test",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:api": "jest --testPathPattern=tests/api",
    "test:property": "jest --testPathPattern=tests/property-based",
    "test:mutation": "stryker run",
    "test:mutation:property": "stryker run -c stryker-property-based.conf.json",
    "test:mutation:ci": "stryker run --ci",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:report": "playwright show-report playwright-report",
    "_comment_docker": "=== Docker ===",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up -d",
    "docker:monitoring": "docker-compose -f docker-compose.monitoring.yml up -d",
    "docker:down": "docker-compose down",
    "docker:clean": "docker-compose down -v --remove-orphans",
    "_comment_production": "=== Production ===",
    "prod:setup": "yarn node scripts/quick-setup-production.js",
    "prod:validate": "yarn tsx scripts/validate-production.ts",
    "prod:deploy": "./scripts/deploy-production.sh production",
    "prod:monitor": "yarn tsx scripts/post-deployment-monitor.ts single",
    "prod:monitor:continuous": "yarn tsx scripts/post-deployment-monitor.ts continuous",
    "_comment_performance": "=== Performance ===",
    "perf": "node scripts/testing/performance-runner.js",
    "perf:suite": "node scripts/testing/performance-runner.js suite",
    "perf:suite:full": "node scripts/testing/performance-runner.js suite --full",
    "perf:artillery": "node scripts/testing/performance-runner.js artillery",
    "perf:artillery:load": "node scripts/testing/performance-runner.js artillery load",
    "perf:artillery:stress": "node scripts/testing/performance-runner.js artillery stress",
    "perf:artillery:all": "node scripts/testing/performance-runner.js artillery all",
    "perf:http": "node scripts/testing/performance-runner.js http",
    "perf:docker": "node scripts/testing/performance-runner.js docker",
    "perf:all": "node scripts/testing/performance-runner.js all",
    "perf:jest": "jest --testPathPattern=tests/performance",
    "perf:jest:api": "jest --testPathPattern=tests/performance/api-benchmarks",
    "perf:jest:db": "jest --testPathPattern=tests/performance/database-benchmarks",
    "perf:jest:cache": "jest --testPathPattern=tests/performance/cache-performance",
    "_comment_features": "=== Fonctionnalités spécifiques ===",
    "qr:test": "yarn tsx scripts/test-qr-system.ts",
    "qr:rotate": "yarn tsx scripts/qr-rotation-cron.ts",
    "email:test": "yarn tsx scripts/test-email-templates.ts",
    "email:info": "yarn tsx scripts/email-system-info.ts",
    "_comment_monitoring": "=== Monitoring & Observability ===",
    "metrics": "curl http://localhost:3000/api/metrics"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^4.1.3",
