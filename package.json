    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@sentry/nextjs": "^8.47.0",
    "@types/express-rate-limit": "^6.0.2",
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.2.8",
