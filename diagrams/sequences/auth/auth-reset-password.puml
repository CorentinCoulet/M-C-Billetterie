@startuml "Réinitialisation de mot de passe - Diagramme de séquence"

title Processus de réinitialisation de mot de passe

actor "Utilisateur" as User
participant "Frontend\n(Next.js)" as Frontend
participant "API Gateway\n(Rate Limiter)" as API
participant "Auth Controller" as AuthCtrl
participant "Auth Service" as AuthSvc
participant "User Service" as UserSvc
participant "Redis Cache" as Redis
participant "Database\n(PostgreSQL)" as DB

== Réinitialisation mot de passe ==
User -> User: Cliquer lien email
activate User
User -> Frontend: GET /reset-password?token=xyz
activate Frontend

Frontend -> API: POST /api/auth/reset-password
note right: Body: {token, newPassword}
activate API

API -> AuthCtrl: resetPassword(token, newPassword)
activate AuthCtrl

AuthCtrl -> Redis: GET reset:{token}
activate Redis
Redis --> AuthCtrl: userId (ou null si expiré)
deactivate Redis

alt Token valide et non expiré
    AuthCtrl -> AuthSvc: validatePasswordStrength(newPassword)
    activate AuthSvc
    AuthSvc -> AuthSvc: Vérifier critères sécurité
    AuthSvc --> AuthCtrl: password valid
    deactivate AuthSvc
    
    AuthCtrl -> AuthSvc: hashPassword(newPassword)
    activate AuthSvc
    AuthSvc -> AuthSvc: bcrypt.hash(newPassword, 12)
    AuthSvc --> AuthCtrl: hashedPassword
    deactivate AuthSvc
    
    AuthCtrl -> UserSvc: updatePassword(userId, hashedPassword)
    activate UserSvc
    UserSvc -> DB: UPDATE users SET password=?, passwordChangedAt=NOW()
    UserSvc -> DB: INSERT INTO password_history (userId, hashedPassword)
    activate DB
    DB --> UserSvc: password updated
    deactivate DB
    deactivate UserSvc
    
    AuthCtrl -> Redis: DEL reset:{token}
    activate Redis
    Redis --> AuthCtrl: token deleted
    deactivate Redis
    
    AuthCtrl -> UserSvc: invalidateAllSessions(userId)
    activate UserSvc
    UserSvc -> DB: DELETE FROM user_sessions WHERE userId=?
    activate DB
    DB --> UserSvc: sessions invalidated
    deactivate DB
    deactivate UserSvc
    
    AuthCtrl --> API: password reset success
    deactivate AuthCtrl
    API --> Frontend: reset successful
    deactivate API
    Frontend --> User: "Mot de passe modifié avec succès"
    deactivate Frontend
    
else Token invalide ou expiré
    AuthCtrl --> API: 400 Bad Request "Invalid or expired token"
    deactivate AuthCtrl
    API --> Frontend: reset failed
    deactivate API
    Frontend --> User: "Lien invalide ou expiré"
    deactivate Frontend
    
else Mot de passe faible
    AuthCtrl --> API: 400 Bad Request "Password too weak"
    deactivate AuthCtrl
    API --> Frontend: validation failed
    deactivate API
    Frontend --> User: "Le mot de passe ne respecte pas les critères de sécurité"
    deactivate Frontend
end

deactivate User

note over User, DB
    Après réinitialisation, toutes les sessions 
    actives sont invalidées pour sécurité
end note

@enduml