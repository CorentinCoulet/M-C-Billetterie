@startuml MLD-Billetterie

scale 0.7
page 2x1

class UTILISATEUR {
    + id : UUID <<PK>>
    --
    * email : String <<UNIQUE>>
    nom : String
    * mot_de_passe : String
    est_verifie : Boolean
    email_verifie_le : DateTime
    derniere_connexion : DateTime
    mot_de_passe_change_le : DateTime
    * role : Enum
    metadonnees : JSON
    * cree_le : DateTime
    * modifie_le : DateTime
}

class ORGANISATEUR {
    + id : UUID <<PK>>
    --
    * nom : String
    * cree_le : DateTime
    * modifie_le : DateTime
}

class EVENEMENT {
    + id : UUID <<PK>>
    --
    * titre : String
    description : Text
    * date : DateTime
    ' lieu text retiré au profit de la FK lieu_id
    capacite_max : Integer
    * est_publie : Boolean
    * est_annule : Boolean
    * achat_anonyme_autorise : Boolean
    * transfert_autorise : Boolean
    # organisateur_id : UUID <<FK>>
    # categorie_id : UUID <<FK>>
    # lieu_id : UUID <<FK>>
    # theme_id : UUID <<FK>>
    metadonnees : JSON
    * cree_le : DateTime
    * modifie_le : DateTime
}

class COMMANDE {
    + id : UUID <<PK>>
    --
    # utilisateur_id : UUID <<FK>>
    * prix_total : Decimal
    * statut : Enum
    code_promo : String
    montant_remise : Decimal
    * devise : String
    metadonnees : JSON
    * cree_le : DateTime
    * modifie_le : DateTime
}

class BILLET {
    + id : UUID <<PK>>
    --
    # utilisateur_id : UUID <<FK>>
    # evenement_id : UUID <<FK>>
    # commande_id : UUID <<FK>>
    * code : String <<UNIQUE>>
    * statut : Enum
    numero_siege : String
    qr_code_actuel : Text
    qr_genere_le : DateTime
    * intervalle_rotation_qr : Integer
    * est_scanne : Boolean
    scanne_le : DateTime
    utilise_le : DateTime
    * achete_le : DateTime
    metadonnees : JSON
}

class PAIEMENT {
    + id : UUID <<PK>>
    --
    # commande_id : UUID <<FK,UNIQUE>>
    * methode_paiement : String
    * statut_paiement : String
    * date_paiement : DateTime
    * id_transaction : String
    * devise : String
}

class CATEGORIE {
    + id : UUID <<PK>>
    --
    * nom : String <<UNIQUE>>
}

class LIEU {
    + id : UUID <<PK>>
    --
    * nom : String
    * adresse : Text
    * capacite : Integer
}

class AVIS {
    + id : UUID <<PK>>
    --
    # utilisateur_id : UUID <<FK>>
    # evenement_id : UUID <<FK>>
    * note : Integer
    commentaire : Text
    * cree_le : DateTime
}

class THEME {
    + id : UUID <<PK>>
    --
    * nom : String
    description : Text
    * chemin_image : String
    couleur : String
    metadonnees : JSON
    * cree_le : DateTime
    * modifie_le : DateTime
}

class MEMBRE_EQUIPE {
    + id : UUID <<PK>>
    --
    # organisateur_id : UUID <<FK>>
    # utilisateur_id : UUID <<FK>>
    * role : String
    * rejoint_le : DateTime
}

' Relations avec cardinalités
UTILISATEUR ||--o{ COMMANDE : "passe"
COMMANDE ||--o{ BILLET : "contient"
BILLET }o--|| EVENEMENT : "concerne"
UTILISATEUR ||--o{ BILLET : "possède"
ORGANISATEUR ||--o{ EVENEMENT : "organise"
CATEGORIE ||--o{ EVENEMENT : "catégorise"
LIEU ||--o{ EVENEMENT : "accueille"
UTILISATEUR ||--o{ AVIS : "rédige"
EVENEMENT ||--o{ AVIS : "reçoit"
THEME ||--o{ EVENEMENT : "stylise"
ORGANISATEUR ||--o{ MEMBRE_EQUIPE : "emploie"
UTILISATEUR ||--o{ MEMBRE_EQUIPE : "travaille_pour"
COMMANDE ||--o| PAIEMENT : "règle_par"

' Notes sur les cardinalités
note right of BILLET : Un billet peut être acheté\nanonymement (utilisateur_id NULL)
note right of AVIS : Contrainte: UNIQUE(user_id, event_id)
note right of EVENEMENT : Un événement peut ne pas\navoir de catégorie, lieu ou thème
note right of PAIEMENT : Une commande peut ne pas\navoir de paiement (statut draft)

@enduml