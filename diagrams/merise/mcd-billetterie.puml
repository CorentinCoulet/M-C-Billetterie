@startuml MCD-Billetterie

' === ENTITÉS (conceptuel, avec identifiants métier) ===
entity UTILISATEUR {
  # email <<identifiant>>
  --
  nom
  role
}

entity ORGANISATEUR {
  # nom <<identifiant>>
}

entity EVENEMENT {
  # titre <<identifiant>>
  --
  date
  capacite_max
  est_publie
  est_annule
}

entity COMMANDE {
  # numero_commande <<identifiant>>
  --
  prix_total
  statut
  devise
}

entity BILLET {
  # code <<identifiant>>
  --
  statut
  numero_siege
  achete_le
}

entity PAIEMENT {
  # id_transaction <<identifiant>>
  --
  methode
  statut
  date_paiement
  montant
}

entity CATEGORIE {
  # nom <<identifiant>>
}

entity LIEU {
  # nom <<identifiant>>
  --
  adresse
  capacite
}

entity AVIS {
  # (utilisateur, evenement) <<identifiant>>
  --
  note
  commentaire
}

entity THEME {
  # nom <<identifiant>>
  --
  chemin_image
}

' Association porteuse d'attributs (conceptuelle)
entity FAIRE_PARTIE_EQUIPE {
  # (utilisateur, organisateur) <<identifiant>>
  --
  role
  rejoint_le
}

' === RELATIONS ET CARDINALITÉS (conceptuel) ===
' Un utilisateur passe 0,n commandes - Une commande est passée par 1,1 utilisateur
UTILISATEUR "1,1" -- "0,n" COMMANDE : passe

' Une commande contient 1,n billets - Un billet est contenu dans 1,1 commande
COMMANDE "1,1" -- "1,n" BILLET : contient

' Un billet concerne 1,1 événement - Un événement a 0,n billets
BILLET "0,n" -- "1,1" EVENEMENT : concerne

' Un utilisateur possède 0,n billets - Un billet peut être possédé par 0,1 utilisateur (invité)
UTILISATEUR "0,1" -- "0,n" BILLET : possède

' Un organisateur organise 0,n événements - Un événement est organisé par 1,1 organisateur
ORGANISATEUR "1,1" -- "0,n" EVENEMENT : organise

' Une catégorie catégorise 0,n événements - Un événement a 0,1 catégorie
CATEGORIE "0,1" -- "0,n" EVENEMENT : catégorise

' Un lieu accueille 0,n événements - Un événement se déroule dans 0,1 lieu
LIEU "0,1" -- "0,n" EVENEMENT : accueille

' Un utilisateur rédige 0,n avis - Un avis est rédigé par 1,1 utilisateur
UTILISATEUR "1,1" -- "0,n" AVIS : rédige

' Un événement reçoit 0,n avis - Un avis concerne 1,1 événement
EVENEMENT "1,1" -- "0,n" AVIS : reçoit

' Un thème stylise 0,n événements - Un événement a 0,1 thème
THEME "0,1" -- "0,n" EVENEMENT : stylise

' Un utilisateur fait partie de 0,n équipes - Association ternaire
UTILISATEUR "1,1" -- "0,n" FAIRE_PARTIE_EQUIPE
FAIRE_PARTIE_EQUIPE "0,n" -- "1,1" ORGANISATEUR

' Une commande est réglée par 0,1 paiement - Un paiement règle 1,1 commande
COMMANDE "1,1" -- "0,1" PAIEMENT : règle

note right of EVENEMENT
  Catégorie, Lieu et Thème sont facultatifs
end note

note right of BILLET
  Un billet peut ne pas être rattaché à un utilisateur
  (achat invité)
end note

@enduml
