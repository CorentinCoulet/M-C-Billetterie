@startuml MCD-Billetterie

' === ENTITÉS ===
entity UTILISATEUR {
  * id : UUID <<PK>>
  email : String <<UNIQUE>>
  nom : String
  mot_de_passe : String
  est_verifie : Boolean
  cree_le : DateTime
  modifie_le : DateTime
}

entity ORGANISATEUR {
  * id : UUID <<PK>>
  nom : String
  cree_le : DateTime
  modifie_le : DateTime
}

entity EVENEMENT {
  * id : UUID <<PK>>
  titre : String
  date : DateTime
  lieu : String
  capacite_max : Integer
  est_publie : Boolean
  cree_le : DateTime
  modifie_le : DateTime
}

entity COMMANDE {
  * id : UUID <<PK>>
  prix_total : Float
  statut : Enum
  devise : String
  cree_le : DateTime
}

entity BILLET {
  * id : UUID <<PK>>
  code : String <<UNIQUE>>
  statut : Enum
  numero_siege : String
  achete_le : DateTime
}

entity PAIEMENT {
  * id : UUID <<PK>>
  methode : String
  statut : String
  date_paiement : DateTime
  montant : Float
}

entity CATEGORIE {
  * id : UUID <<PK>>
  nom : String <<UNIQUE>>
}

entity LIEU {
  * id : UUID <<PK>>
  nom : String
  adresse : String
  capacite : Integer
}

entity AVIS {
  * id : UUID <<PK>>
  note : Integer
  commentaire : String
  cree_le : DateTime
}

entity THEME {
  * id : UUID <<PK>>
  nom : String
  chemin_image : String
  cree_le : DateTime
}

' === RELATIONS AVEC CARDINALITÉS ===
UTILISATEUR ||--o{ COMMANDER
COMMANDER }o--|| COMMANDE

COMMANDE ||--|| CONTENIR
CONTENIR ||--o{ BILLET

BILLET ||--|| CONCERNER
CONCERNER }o--|| EVENEMENT

UTILISATEUR ||--o{ POSSEDER
POSSEDER }o--|| BILLET

ORGANISATEUR ||--|| ORGANISER
ORGANISER ||--o{ EVENEMENT

CATEGORIE ||--o{ CATEGORISER
CATEGORISER }o--|| EVENEMENT

LIEU ||--o{ SE_DEROULER
SE_DEROULER }o--|| EVENEMENT

UTILISATEUR ||--o{ EVALUER
EVALUER }o--|| EVENEMENT
EVALUER ||--|| AVIS

THEME ||--o{ APPLIQUER_THEME
APPLIQUER_THEME }o--|| EVENEMENT

UTILISATEUR ||--o{ FAIRE_PARTIE_EQUIPE
FAIRE_PARTIE_EQUIPE }o--|| ORGANISATEUR

COMMANDE ||--|| PAYER
PAYER ||--o| PAIEMENT
@enduml
