@startuml MCD-Billetterie

' === ENTITÉS (conceptuel, avec identifiants métier) ===
entity UTILISATEUR {
  # email <<identifiant>>
  --
  nom
  role
}

entity ORGANISATEUR {
  # nom <<identifiant>>
}

entity EVENEMENT {
  # titre <<identifiant>>
  --
  date
  capacite_max
  est_publie
  est_annule
}

entity COMMANDE {
  # numero_commande <<identifiant>>
  --
  prix_total
  statut
  devise
}

entity BILLET {
  # code <<identifiant>>
  --
  statut
  numero_siege
  achete_le
}

entity PAIEMENT {
  # id_transaction <<identifiant>>
  --
  methode
  statut
  date_paiement
  montant
}

entity CATEGORIE {
  # nom <<identifiant>>
}

entity LIEU {
  # nom <<identifiant>>
  --
  adresse
  capacite
}

entity AVIS {
  # (utilisateur, evenement) <<identifiant>>
  --
  note
  commentaire
}

entity THEME {
  # nom <<identifiant>>
  --
  chemin_image
}

' Association porteuse d'attributs (conceptuelle)
entity FAIRE_PARTIE_EQUIPE {
  # (utilisateur, organisateur) <<identifiant>>
  --
  role
  rejoint_le
}

' === RELATIONS ET CARDINALITÉS (conceptuel) ===
UTILISATEUR ||--o{ COMMANDE : passe
COMMANDE ||--o{ BILLET : contient
BILLET }o--|| EVENEMENT : concerne
UTILISATEUR ||--o{ BILLET : possède
ORGANISATEUR ||--o{ EVENEMENT : organise
CATEGORIE ||--o{ EVENEMENT : catégorise
LIEU ||--o{ EVENEMENT : accueille
UTILISATEUR ||--o{ AVIS : rédige
EVENEMENT ||--o{ AVIS : reçoit
THEME ||--o{ EVENEMENT : stylise
UTILISATEUR ||--o{ FAIRE_PARTIE_EQUIPE
FAIRE_PARTIE_EQUIPE }o--|| ORGANISATEUR
COMMANDE ||--o| PAIEMENT : règle

note right of EVENEMENT
  Catégorie, Lieu et Thème sont facultatifs
end note

note right of BILLET
  Un billet peut ne pas être rattaché à un utilisateur
  (achat invité)
end note

@enduml
