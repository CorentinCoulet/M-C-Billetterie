package "Base de Données PostgreSQL - Sessions & Activités" {

    class "users" as users2 <<table>> {
        + id : UUID <<PK>>
    }

    class "user_sessions" as user_sessions <<table>> {
        + id : UUID <<PK>>
        user_id : UUID <<FK>>
        token : VARCHAR(255) <<UNIQUE>>
        ip_address : VARCHAR(255)
        user_agent : TEXT
        device_info : TEXT
        created_at : TIMESTAMPTZ
        last_activity_at : TIMESTAMPTZ
        expires_at : TIMESTAMPTZ
        is_active : BOOLEAN
        destroyed_at : TIMESTAMPTZ
        destroy_reason : TEXT
        --
        <<indexes>>
        idx_user_sessions_user_id
        idx_user_sessions_token
    }

    class "activity_logs" as activity_logs <<table>> {
        + id : UUID <<PK>>
        user_id : UUID <<FK>>
        action : VARCHAR(255)
        target_type : VARCHAR(100)
        target_id : VARCHAR(255)
        timestamp : TIMESTAMPTZ
        --
        <<indexes>>
        idx_activity_logs_user_id
        idx_activity_logs_timestamp
    }

    class "event_logs" as event_logs <<table>> {
        + id : UUID <<PK>>
        user_id : UUID <<FK>>
        type : VARCHAR(100)
        context : TEXT
        created_at : TIMESTAMPTZ
        --
        <<indexes>>
        idx_event_logs_user_id
        idx_event_logs_type
    }

    class "notifications" as notifications <<table>> {
        + id : UUID <<PK>>
        user_id : UUID <<FK>>
        type : VARCHAR(100)
        message : TEXT
        is_read : TIMESTAMPTZ
        sent_at : TIMESTAMPTZ
        --
        <<indexes>>
        idx_notifications_user_id
    }
}

' Relations - Page 3
user_sessions }o--|| users2 : "user_id"
activity_logs }o--|| users2 : "user_id"
event_logs }o--|| users2 : "user_id"
notifications }o--|| users2 : "user_id"

' Notes - Page 3
note right of user_sessions : Gestion des sessions utilisateur\navec tracking IP et device\nExpiration automatique

note bottom of notifications : Système de notifications\navec suivi de lecture

newpage

package "Base de Données PostgreSQL - Sécurité Utilisateurs" {

    class "users" as users3 <<table>> {
        + id : UUID <<PK>>
    }

    class "blocked_users" as blocked_users <<table>> {
        + id : UUID <<PK>>
        user_id : UUID <<FK,UNIQUE>>
        reason : TEXT
        blocked_at : TIMESTAMPTZ
        --
        <<constraints>>
        user_id UNIQUE
    }

    class "password_history" as password_history <<table>> {
        + id : UUID <<PK>>
        user_id : UUID <<FK>>
        password_hash : TEXT
        created_at : TIMESTAMPTZ
        --
        <<indexes>>
        idx_password_history_user_id
    }

    class "login_attempts" as login_attempts <<table>> {
        + id : UUID <<PK>>
        user_id : UUID <<FK>>
        email : VARCHAR(255)
        ip_address : VARCHAR(64)
        user_agent : TEXT
        success : BOOLEAN
        timestamp : TIMESTAMPTZ
        reason : TEXT
        session_id : VARCHAR(255)
        risk_score : INTEGER
        --
        <<indexes>>
        idx_login_attempts_user_id
        idx_login_attempts_email
        idx_login_attempts_timestamp
    }

    class "blocked_ip" as blocked_ip <<table>> {
        + id : UUID <<PK>>
        ip_address : VARCHAR(64) <<UNIQUE>>
        reason : TEXT
        blocked_at : TIMESTAMPTZ
        expires_at : TIMESTAMPTZ
        block_count : INTEGER
        unblocked_by : VARCHAR(255)
        unblocked_at : TIMESTAMPTZ
        --
        <<constraints>>
        ip_address UNIQUE
    }
}

' Relations - Page 4
blocked_users }o--|| users3 : "user_id"
password_history }o--|| users3 : "user_id"
login_attempts }o--|| users3 : "user_id"

' Notes - Page 4
note right of blocked_users : Utilisateurs bloqués\navec raison

note right of password_history : Historique des mots de passe\npour éviter la réutilisation

note bottom of blocked_ip : Système de blocage IP\navec expiration automatique

newpage

package "Base de Données PostgreSQL - Logs & Audit" {

    class "security_logs" as security_logs <<table>> {
        + id : UUID <<PK>>
        type : VARCHAR(100)
        ip : VARCHAR(64)
        user_agent : TEXT
        url : TEXT
        user_id : UUID
        data : TEXT
        timestamp : TIMESTAMPTZ
        --
        <<indexes>>
        idx_security_logs_type
        idx_security_logs_timestamp
        idx_security_logs_user_id
    }

    class "audit_logs" as audit_logs <<table>> {
        + id : UUID <<PK>>
        action : VARCHAR(100)
        resource_type : VARCHAR(50)
        resource_id : VARCHAR(255)
        user_id : UUID
        user_email : VARCHAR(255)
        ip_address : VARCHAR(64)
        user_agent : TEXT
        details : TEXT
        timestamp : TIMESTAMPTZ
        session_id : VARCHAR(255)
        result : VARCHAR(20)
        risk_level : VARCHAR(20)
        event_hash : VARCHAR(64)
        is_sensitive : BOOLEAN
        --
        <<indexes>>
        idx_audit_logs_user_id
        idx_audit_logs_timestamp
        idx_audit_logs_resource
    }
}

' Notes - Page 5
note right of security_logs : Logs de sécurité détaillés\npour analyse forensique\nTracking complet des actions

note bottom of audit_logs : Logs d'audit complets\navec hash pour intégrité\nRisk level pour alertes

newpage

package "Base de Données PostgreSQL - Système & i18n" {

    class "system_backups" as system_backups <<table>> {
        + id : UUID <<PK>>
        type : VARCHAR(50)
        status : VARCHAR(50)
        file_path : TEXT
        encryption_key : TEXT
        file_size : BIGINT
        checksum_sha256 : VARCHAR(64)
        started_at : TIMESTAMPTZ
        completed_at : TIMESTAMPTZ
        error : TEXT
        retention_days : INTEGER
        --
        <<indexes>>
        idx_system_backups_status
        idx_system_backups_started_at
    }

    class "translations" as translations <<table>> {
        + id : UUID <<PK>>
        entity_type : VARCHAR(100)
        entity_id : VARCHAR(255)
        locale : VARCHAR(10)
        field : VARCHAR(100)
        value : TEXT
        --
        <<indexes>>
        idx_translations_entity
        idx_translations_locale
        --
        <<constraints>>
        UNIQUE(entity_type, entity_id, locale, field)
    }
}

' Notes - Page 6
note right of system_backups : Gestion des sauvegardes\navec chiffrement et checksum\nRétention configurable

note bottom of translations : Système i18n\nTraductions par entité\net par locale

@enduml