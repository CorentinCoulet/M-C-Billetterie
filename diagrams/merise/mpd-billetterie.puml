    class "events" as events2 <<table>> {
        + id : UUID <<PK>>
    }

    class "organizers" as organizers2 <<table>> {
        + id : UUID <<PK>>
    }

    class "categories" as categories2 <<table>> {
        + id : UUID <<PK>>
    }

    class "venues" as venues2 <<table>> {
        + id : UUID <<PK>>
    }

    class "themes" as themes2 <<table>> {
        + id : UUID <<PK>>
    }

    class "reviews" as reviews2 <<table>> {
        + id : UUID <<PK>>
    }

    class "team_members" as team_members2 <<table>> {
        + id : UUID <<PK>>
    }

    class "users" as users_ref1 <<table>> {
        + id : UUID <<PK>>
    }
}

' Relations avec contraintes référentielles - Page 2
events2 }o--|| organizers2 : "organizer_id"
events2 }o--|| categories2 : "category_id"
events2 }o--|| venues2 : "venue_id"
events2 }o--|| themes2 : "theme_id"

reviews2 }o--|| users_ref1 : "user_id"
reviews2 }o--|| events2 : "event_id"

team_members2 }o--|| organizers2 : "organizer_id"
team_members2 }o--|| users_ref1 : "user_id"

