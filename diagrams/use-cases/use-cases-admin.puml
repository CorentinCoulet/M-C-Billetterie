@startuml "Diagramme de cas d'utilisation - Administrateur"

title Diagramme de cas d'utilisation - Rôle Administrateur

left to right direction

actor "Administrateur" as Admin
actor "Organisateur" as Organizer

rectangle "Système de Billetterie" {
  ' Gestion des utilisateurs
  usecase "Consulter tous les utilisateurs" as UC1
  usecase "Créer utilisateur" as UC2
  usecase "Modifier rôle utilisateur" as UC3
  usecase "Bloquer/Débloquer utilisateur" as UC4
  usecase "Supprimer utilisateur" as UC5
  usecase "Consulter historique utilisateur" as UC6
  usecase "Gérer sessions utilisateurs" as UC7
  
  ' Gestion des organisateurs
  usecase "Valider organisateur" as UC8
  usecase "Suspendre organisateur" as UC9
  usecase "Gérer profils organisateurs" as UC10
  usecase "Auditer activités organisateurs" as UC11
  
  ' Gestion globale des événements
  usecase "Modérer événements" as UC12
  usecase "Supprimer événement" as UC13
  usecase "Forcer publication événement" as UC14
  usecase "Gérer catégories globales" as UC15
  usecase "Configurer thèmes" as UC16
  
  ' Gestion des transactions
  usecase "Consulter toutes les commandes" as UC17
  usecase "Gérer remboursements globaux" as UC18
  usecase "Auditer paiements" as UC19
  usecase "Gérer litiges" as UC20
  usecase "Consulter revenus plateforme" as UC21
  
  ' Administration système
  usecase "Consulter tableau de bord admin" as UC22
  usecase "Configurer paramètres système" as UC23
  usecase "Gérer notifications système" as UC24
  usecase "Consulter logs système" as UC25
  usecase "Gérer sauvegardes" as UC26
  usecase "Monitoring performances" as UC27
  
  ' Sécurité et conformité
  usecase "Consulter logs sécurité" as UC28
  usecase "Gérer accès API" as UC29
  usecase "Configurer règles sécurité" as UC30
  usecase "Auditer conformité RGPD" as UC31
  usecase "Gérer certificats SSL" as UC32
  
  ' Rapports et analytics
  usecase "Générer rapports globaux" as UC33
  usecase "Analyser métriques plateforme" as UC34
  usecase "Exporter données" as UC35
  usecase "Configurer alertes" as UC36
  
  ' Gestion du contenu
  usecase "Modérer avis" as UC37
  usecase "Gérer contenu FAQ" as UC38
  usecase "Configurer emails templates" as UC39
  usecase "Gérer traductions" as UC40
  
  ' Support client avancé
  usecase "Accéder à tous les tickets support" as UC41
  usecase "Résoudre problèmes techniques" as UC42
  usecase "Gérer escalades" as UC43
}

