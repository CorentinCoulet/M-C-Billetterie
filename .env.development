# =================================
# BILLETTERIE - Environment Configuration
# =================================
# Copiez ce fichier vers .env et adaptez les valeurs

# =================================
# DATABASE
# =================================
DATABASE_URL=postgresql://user:password@localhost:5432/billetterie

# =================================
# APPLICATION
# =================================
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# =================================
# AUTHENTICATION & SECURITY
# =================================
JWT_SECRET=your-super-secure-jwt-secret-minimum-256-bits-long-for-development
JWT_REFRESH_SECRET=your-refresh-secret-different-from-main-secret
SESSION_SECRET=your-session-secret-32-chars-minimum

# Encryption (générer des clés sécurisées en production)
ENCRYPTION_KEY=your-32-char-encryption-key-here
AES_SECRET=your-aes-secret-key-32-chars-min
DATA_ENCRYPTION_KEY=your-data-encryption-key-here

# =================================
# EXTERNAL SERVICES
# =================================
# Redis (optionnel en développement)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Stripe
STRIPE_SECRET_KEY=sk_test_your_test_key
STRIPE_PUBLIC_KEY=pk_test_your_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# =================================
# MONITORING (optionnel)
# =================================
SENTRY_DSN=
LOG_LEVEL=info
