# Test Environment Configuration
NODE_ENV=test
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/billetterie_test?schema=public"

# Docker Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=billetterie_test
DB_PORT=5432

# JWT Secret for tests (must match test expectations)
JWT_SECRET="test-jwt-secret-key-for-testing-purposes-that-is-at-least-32-chars-long"
JWT_EXPIRES_IN="7d"
ENCRYPTION_KEY="test-encryption-key-that-is-32-chars"
SESSION_SECRET="test-session-secret"
BCRYPT_SALT_ROUNDS="10"

# Server
PORT=3001

# URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Features
FEATURE_AUTH_ENABLED="true"
FEATURE_PAYMENTS_ENABLED="true"
FEATURE_EMAIL_ENABLED="false"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# Cache
CACHE_ENABLED="false"
CACHE_TTL="3600"

# Security
HELMET_ENABLED="false"
CORS_ENABLED="true"

# Stripe (test values)
STRIPE_SECRET_KEY="sk_test_fake_key"
STRIPE_PUBLISHABLE_KEY="pk_test_fake_key"
STRIPE_WEBHOOK_SECRET="whsec_fake_secret"
STRIPE_CURRENCY="eur"

# Temporary file storage for tests
UPLOAD_DIR="./tmp/test-uploads"
UPLOAD_BASE_DIR="./tmp/test-uploads"
MAX_FILE_SIZE="5242880"

# QR Code settings for tests
QR_SECRET_KEY="test-qr-secret-key"
QR_ROTATION_INTERVAL=24

# Email settings for tests (mock)
SMTP_HOST="smtp.test.com"
SMTP_PORT=587
SMTP_USER="test@example.com"
SMTP_PASS="testpassword"
EMAIL_FROM="test@billetterie.com"
CONTACT_EMAIL="test@billetterie.com"

# Disable external services in tests
DISABLE_EXTERNAL_SERVICES=true
