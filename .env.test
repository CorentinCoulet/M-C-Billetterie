# ===================================================================
# ENVIRONMENT DE TEST - TESTS E2E PLAYWRIGHT
# ===================================================================

# =================================
# NODE ENVIRONMENT
# =================================
NODE_ENV=test

# =================================
# DATABASE CONFIGURATION (TEST)
# =================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/billetterie_test
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=billetterie_test
DB_HOST=localhost
DB_PORT=5432

# =================================
# REDIS CONFIGURATION (TEST)
# =================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =================================
# JWT & AUTH SECRETS (TEST)
# =================================
JWT_SECRET=test-secret-jwt-32-characters-long-minimum-for-security
JWT_REFRESH_SECRET=test-refresh-secret-jwt-32-characters-minimum
NEXTAUTH_SECRET=test-nextauth-secret-32-characters-long-for-security
NEXTAUTH_URL=http://localhost:3000

# =================================
# APPLICATION URLs
# =================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =================================
# STRIPE (TEST MODE)
# =================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_fake_key
STRIPE_SECRET_KEY=sk_test_fake_key
STRIPE_WEBHOOK_SECRET=whsec_test_fake

# =================================
# EMAIL CONFIGURATION (TEST - NO REAL EMAILS)
# =================================
EMAIL_HOST=smtp.test.com
EMAIL_PORT=587
EMAIL_USER=test@test.com
EMAIL_PASSWORD=testpassword
EMAIL_FROM=test@test.com
EMAIL_SECURE=false

# =================================
# MONITORING (DISABLED FOR TESTS)
# =================================
SENTRY_DSN=
SENTRY_ENABLED=false

# =================================
# RATE LIMITING (RELAXED FOR TESTS)
# =================================
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100

# =================================
# SEED PASSWORDS (FOR TEST DATA)
# Ces mots de passe seront utilisés pour créer les comptes de test
# =================================
SEED_ADMIN_PASSWORD=AdminDemo123!
SEED_ORGANIZER_PASSWORD=OrganizerDemo123!
SEED_USER_PASSWORD=UserDemo123!

