{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "yarn",
  "testRunner": "jest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/services/**/*.ts",
    "src/controllers/**/*.ts",
    "src/utils/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "!src/**/__tests__/**"
  ],
  "mutator": {
    "plugins": ["@stryker-mutator/typescript-checker"],
    "excludedMutations": []
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "timeoutMS": 300000,
  "concurrency": 4,
  "reporters": ["html", "clear-text", "progress", "json"],
  "htmlReporter": {
    "baseDir": "coverage/mutation"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/mutation.json"
  },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "ignorePatterns": [
    "node_modules",
    "coverage",
    "dist",
    ".next",
    "tests"
  ]
}
