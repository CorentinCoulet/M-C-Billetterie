{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "yarn",
  "testRunner": "jest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/services/**/*.ts",
    "src/controllers/**/*.ts",
    "src/utils/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "!src/**/__tests__/**"
  ],
  "mutator": {
    "plugins": ["@stryker-mutator/typescript-checker"],
    "excludedMutations": []
  },
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.js",
    "enableFindRelatedTests": true
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "timeoutMS": 300000,
  "concurrency": 4,
  "reporters": ["html", "clear-text", "progress", "json"],
  "htmlReporter": {
    "fileName": "coverage/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/mutation.json"
  },
  "checkers": [],
  "tsconfigFile": "tsconfig.json",
  "ignorePatterns": [
    "node_modules",
    "coverage",
    "dist",
    ".next",
    "tests"
  ],
  "ignoreStatic": true,
  "disableTypeChecks": false,
  "_comment_property_based": "Pour tester les tests property-based, utilisez: yarn test:mutation --mutate='tests/property-based/**/*.test.ts' --concurrency=2 --htmlReporter.fileName='coverage/mutation-property-based/index.html'"
}
