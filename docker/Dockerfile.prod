# Multi-stage build for production
# Security-hardened production Dockerfile

# Build stage
FROM node:18-alpine AS builder

# Create app directory
WORKDIR /app

# Add build dependencies
RUN apk add --no-cache python3 make g++

# Copy package files
COPY package.json yarn.lock ./
COPY tsconfig.json ./

# Install dependencies (including dev dependencies for build)
RUN yarn install --frozen-lockfile

# Copy source code
COPY . .

# Generate Prisma client
RUN yarn prisma generate

# Build application
RUN yarn build

# Remove dev dependencies (keep only production)
RUN yarn install --production --frozen-lockfile

# Production stage
FROM node:18-alpine AS production

# Create non-root user
RUN addgroup -g 1001 -S nodejs
RUN adduser -S billetterie -u 1001

# Install security updates and required packages
RUN apk add --no-cache \
    dumb-init \
    tini \
    ca-certificates \
    && apk upgrade --no-cache \
    && rm -rf /var/cache/apk/*

# Set working directory
WORKDIR /app

# Copy built application
COPY --from=builder --chown=billetterie:nodejs /app/dist ./dist
COPY --from=builder --chown=billetterie:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=billetterie:nodejs /app/package.json /app/yarn.lock ./
COPY --from=builder --chown=billetterie:nodejs /app/prisma ./prisma
COPY --from=builder --chown=billetterie:nodejs /app/src/generated ./src/generated

# Create required directories
RUN mkdir -p /app/logs /app/uploads /app/backups \
    && chown -R billetterie:nodejs /app

# Switch to non-root user
USER billetterie

# Set production environment
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=512"

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })"

# Expose port
EXPOSE 3000

# Use tini as PID 1 for proper signal handling
ENTRYPOINT ["/sbin/tini", "--"]

# Run migrations and start application
CMD ["sh", "-c", "yarn prisma migrate deploy && node dist/server.js"]
