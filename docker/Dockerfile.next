# Multi-stage build for Next.js application
FROM node:24-alpine AS base

# Install dependencies only when needed
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

    # Install dependencies based on the preferred package manager (YARN ONLY)
    COPY package.json ./
    COPY yarn.lock* ./
    RUN if [ -f yarn.lock ]; then yarn install --frozen-lockfile; else yarn install; fi

# Rebuild the source code only when needed
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Create the directory for Prisma generated client
RUN mkdir -p /app/src/generated/prisma

# Generate Prisma Client
# Provide a dummy DATABASE_URL so Prisma can validate the schema at build time
# Ensure required system libraries for Prisma engines on Alpine
RUN apk add --no-cache libc6-compat openssl ca-certificates
ENV DATABASE_URL="postgresql://fake:fake@localhost:5432/fake"
ENV DIRECT_URL="postgresql://fake:fake@localhost:5432/fake"
RUN yarn prisma generate

# Set build-time environment variables to prevent runtime issues
ENV NEXT_PHASE=phase-production-build
ENV NODE_ENV=production

# Next.js collects completely anonymous telemetry data about general usage.
# Learn more here: https://nextjs.org/telemetry
# Uncomment the following line in case you want to disable telemetry during the build.
ENV NEXT_TELEMETRY_DISABLED=1

# Build with minimal Stripe configuration to avoid build errors
ENV STRIPE_SECRET_KEY=sk_test_build_placeholder
ENV STRIPE_WEBHOOK_SECRET=whsec_build_placeholder

RUN ESLINT_NO_DEV_ERRORS=true yarn build

# Production image, copy all the files and run next
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public

# Set the correct permission for prerender cache
RUN mkdir .next
RUN chown nextjs:nodejs .next

# Automatically leverage output traces to reduce image size
# https://nextjs.org/docs/advanced-features/output-file-tracing
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME=0.0.0.0

CMD ["node", "server.js"]
