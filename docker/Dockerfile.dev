FROM node:24-alpine AS base

# Add user first to avoid permission issues
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --ingroup nodejs nextjs

WORKDIR /app

# Dependencies stage
FROM base AS deps
# Install dependencies with increased timeouts and retry logic
COPY package.json yarn.lock ./
RUN yarn config set network-timeout 600000 && \
    yarn config set registry https://registry.yarnpkg.com && \
    yarn install --frozen-lockfile --network-timeout 600000

# Development stage
FROM base AS development

# Copy dependencies from previous stage
COPY --from=deps --chown=nextjs:nodejs /app/node_modules ./node_modules

# Copy only necessary files for Prisma
COPY --chown=nextjs:nodejs package.json yarn.lock ./
COPY --chown=nextjs:nodejs prisma ./prisma/

# Generate Prisma client
RUN yarn prisma generate

# Copy source code (minimal files due to .dockerignore)
COPY . .

# Remove any existing .next directory and recreate with proper permissions
# Optimized: only chown specific directories, not entire /app (too slow on Windows)
RUN rm -rf .next && \
    mkdir -p uploads .next/cache logs && \
    chown -R nextjs:nodejs uploads .next logs prisma 2>/dev/null || true

# Switch to non-root user
USER nextjs

EXPOSE 3001

# Use a shell to run multiple commands
CMD ["sh", "-c", "yarn prisma migrate deploy && yarn dev:docker"]
