
FROM node:25-alpine AS base

# Add user first to avoid permission issues
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --ingroup nodejs nextjs

WORKDIR /app

FROM base AS development

# Copy only package files (not installing yet)
COPY package.json yarn.lock ./

# Copy prisma schema
COPY prisma ./prisma/

# Copy source code (minimal files due to .dockerignore)
COPY . .

# In development, we run as root to avoid permission issues with mounted volumes
USER root

EXPOSE 3001

# Install dependencies at runtime (uses volume mount from docker-compose)
# This way node_modules are persisted and no network call during build
CMD ["sh", "-c", "mkdir -p /app/.next /app/logs /app/uploads \
  && chmod -R 777 /app/.next /app/logs /app/uploads \
  && echo '[dev] Installing dependencies if needed...' \
  && if [ ! -d node_modules ] || [ ! -f node_modules/.yarn-integrity ]; then yarn install --frozen-lockfile; fi \
  && echo '[dev] Generating Prisma client...' \
  && yarn prisma generate \
  && echo '[dev] Running Prisma migrate deploy...' \
  && yarn prisma migrate deploy \
  && if [ \"$SEED\" = \"true\" ]; then echo '[dev] Running Prisma seed...'; yarn prisma db seed || true; fi \
  && yarn dev:docker"]
