FROM node:22-alpine AS base

# Add user first to avoid permission issues
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --ingroup nodejs nextjs

WORKDIR /app

# Dependencies stage
FROM base AS deps
# Install dependencies with increased timeouts and retry logic
COPY package.json yarn.lock ./
RUN yarn config set network-timeout 600000 && \
    yarn config set registry https://registry.yarnpkg.com && \
    yarn install --frozen-lockfile --network-timeout 600000

# Development stage
FROM base AS development

# Copy dependencies from previous stage
COPY --from=deps /app/node_modules ./node_modules

# Copy only necessary files for Prisma
COPY package.json yarn.lock ./
COPY prisma ./prisma/

# Generate Prisma client
RUN yarn prisma generate

# Copy source code (minimal files due to .dockerignore)
COPY . .

# Create directories with proper permissions
RUN mkdir -p uploads .next .next/cache logs && \
    chown -R nextjs:nodejs /app

# In development, we run as root to avoid permission issues with mounted volumes
# The volumes will be mounted from the host, so we need root access
USER root

EXPOSE 3001

# Use a shell to run multiple commands and ensure permissions at startup
# If SEED=true (from .env.dev), run prisma seed once after migrations
CMD ["sh", "-c", "mkdir -p /app/.next /app/logs /app/uploads \
  && chmod -R 777 /app/.next /app/logs /app/uploads \
  && echo '[dev] Running Prisma migrate deploy...' \
  && yarn prisma migrate deploy \
  && if [ \"$SEED\" = \"true\" ]; then echo '[dev] Running Prisma seed...'; yarn prisma db seed || true; fi \
  && yarn dev:docker"]
