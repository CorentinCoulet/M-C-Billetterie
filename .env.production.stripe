# Configuration Stripe for Production
# Copy this file to .env.production

# =================================
# STRIPE API CONFIGURATION
# =================================
STRIPE_API_VERSION=2025-06-30.basil
STRIPE_DEFAULT_API_VERSION=2025-06-30.basil
STRIPE_SUPPORTED_VERSIONS=2025-06-30.basil,2024-06-20,2024-04-10

# =================================
# CURRENCY CONFIGURATION
# =================================
STRIPE_DEFAULT_CURRENCY=EUR
STRIPE_SUPPORTED_CURRENCIES=EUR,USD,GBP,CAD,CHF,SEK,NOK,DKK

# =================================
# WEBHOOK & PERFORMANCE SETTINGS (Production optimized)
# =================================
STRIPE_WEBHOOK_TOLERANCE=300
STRIPE_MAX_RETRIES=5
STRIPE_RETRY_DELAY=1000
STRIPE_MAX_PROCESSED_EVENTS=5000
STRIPE_CACHE_CLEANUP_SIZE=2500
STRIPE_CACHE_CLEANUP_INTERVAL=3600000  # 1 hour
