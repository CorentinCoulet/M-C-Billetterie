# =================================
# CONFIGURATION PRODUCTION LOCALE (TEST)
# =================================
NODE_ENV=production
PORT=3002

# =================================
# DATABASE CONFIGURATION
# =================================
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=billetterie
DB_PORT=5433
DATABASE_URL=postgresql://postgres:postgres123@postgres-prod:5432/billetterie

# =================================
# REDIS CONFIGURATION
# =================================
REDIS_PASSWORD=password
REDIS_PORT=6380
REDIS_URL=redis://:password@redis-prod:6379

# =================================
# AUTHENTICATION & SECURITY
# =================================
JWT_SECRET=production_jwt_secret_key_32_chars_long_very_secure_123456789
JWT_REFRESH_SECRET=production_refresh_secret_key_32_chars_long_secure_abcdef
ENCRYPTION_KEY=production_encryption_key_32_chars_long_secure_1234567890
AES_SECRET=production_aes_secret_key_32_chars_long_secure_abcdef123456
DATA_ENCRYPTION_KEY=production_data_encryption_key_32_chars_secure_xyz789
SESSION_SECRET=production_session_secret_key_32_chars_secure_session_abc
QR_ROTATION_SECRET=production_qr_rotation_secret_32_chars_secure_qr_key123

# =================================
# URLS
# =================================
NEXT_PUBLIC_APP_URL=http://localhost:3002
DOMAIN=localhost
SSL_EMAIL=admin@localhost

# =================================
# STRIPE PAYMENT (Test)
# =================================
STRIPE_SECRET_KEY=sk_test_production
STRIPE_PUBLISHABLE_KEY=pk_test_production
STRIPE_WEBHOOK_SECRET=whsec_production
STRIPE_CURRENCY=eur

# =================================
# EMAIL CONFIGURATION
# =================================
EMAIL_FROM=noreply@billetterie-test.com
CONTACT_EMAIL=contact@billetterie-test.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=test@example.com
SMTP_PASS=test_password

# =================================
# FEATURES
# =================================
FEATURE_AUTH_ENABLED=true
FEATURE_EVENTS_ENABLED=true
FEATURE_PAYMENTS_ENABLED=false
FEATURE_EMAIL_ENABLED=true

# =================================
# SECURITY SETTINGS
# =================================
SECURITY_HELMET_ENABLED=true
SECURITY_CORS_ENABLED=true
SECURITY_RATE_LIMIT_ENABLED=true

# =================================
# MONITORING
# =================================
GRAFANA_ADMIN_PASSWORD=admin123
PROMETHEUS_ENABLED=true
MONITORING_LOGGING_ENABLED=true
LOG_LEVEL=info

# =================================
# PERFORMANCE
# =================================
CACHE_ENABLED=true
CACHE_TTL=3600

# =================================
# RATE LIMITING
# =================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =================================
# FILE UPLOAD
# =================================
UPLOAD_BASE_DIR=./uploads
MAX_FILE_SIZE=5242880

# =================================
# BACKUP (Disabled for local test)
# =================================
BACKUP_ENCRYPTION_KEY=test_backup_encryption_key_32_chars_long_123456789