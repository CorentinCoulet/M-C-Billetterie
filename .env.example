# =================================
# EXAMPLE ENVIRONMENT CONFIGURATION
# =================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real credentials to git!

# =================================
# APPLICATION CONFIGURATION
# =================================
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# =================================
# DATABASE CONFIGURATION
# =================================
# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/billetterie_dev

# Database pool settings (optional)
DATABASE_MAX_CONNECTIONS=10
DATABASE_TIMEOUT=30000

# =================================
# REDIS CONFIGURATION (Optional)
# =================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# =================================
# AUTHENTICATION & SECURITY
# =================================
# JWT secrets - MUST be at least 32 characters long!
JWT_SECRET=your_jwt_secret_key_32_chars_minimum_change_this
JWT_REFRESH_SECRET=your_jwt_refresh_secret_32_chars_minimum_change_this
JWT_EXPIRES_IN=7d

# Encryption keys - MUST be at least 32 characters long!
ENCRYPTION_KEY=your_encryption_key_32_chars_minimum_change_this
AES_SECRET=your_aes_secret_32_chars_minimum_change_this
DATA_ENCRYPTION_KEY=your_data_encryption_key_32_chars_minimum_change_this
FINANCIAL_ENCRYPTION_KEY=your_financial_encryption_key_32_chars_minimum_change_this
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_32_chars_minimum_change_this
FIELD_ENCRYPTION_KEY=your_field_encryption_key_32_chars_minimum_change_this

# Session configuration
SESSION_SECRET=your_session_secret_32_chars_minimum_change_this
SESSION_EXPIRES=604800000

# Password security
BCRYPT_SALT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_PEPPER=your_password_pepper_32_chars_minimum_change_this
MFA_SECRET=your_mfa_secret_32_chars_minimum_change_this

# =================================
# STRIPE PAYMENT CONFIGURATION
# =================================
# Get these from your Stripe dashboard
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_CURRENCY=EUR
STRIPE_TEST_MODE=true

# Stripe API Configuration
STRIPE_API_VERSION=2025-06-30.basil
STRIPE_DEFAULT_API_VERSION=2025-06-30.basil
STRIPE_SUPPORTED_VERSIONS=2025-06-30.basil,2024-06-20,2024-04-10,2024-02-15,2023-10-16

# Stripe Currencies
STRIPE_DEFAULT_CURRENCY=EUR
STRIPE_SUPPORTED_CURRENCIES=EUR,USD,GBP

# Stripe Webhook & Cache Settings
STRIPE_WEBHOOK_TOLERANCE=300
STRIPE_MAX_RETRIES=3
STRIPE_RETRY_DELAY=1000
STRIPE_MAX_PROCESSED_EVENTS=1000
STRIPE_CACHE_CLEANUP_SIZE=500
STRIPE_CACHE_CLEANUP_INTERVAL=3600000

# =================================
# EMAIL CONFIGURATION
# =================================
# SMTP settings for sending emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=true
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM=noreply@yourdomain.com

# Email addresses
CONTACT_EMAIL=contact@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# Alternative SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password

# =================================
# MONITORING & LOGGING
# =================================
# Sentry for error tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_RELEASE=billetterie@1.0.0
SENTRY_ENVIRONMENT=development
SENTRY_DEBUG=false

# Prometheus/Grafana (Optional but recommended)
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password

# =================================
# SECURITY CONFIGURATION
# =================================
# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Security headers
HELMET_ENABLED=true
CSRF_ENABLED=true
CSRF_COOKIE_NAME=csrf
CSRF_HEADER_NAME=X-CSRF-Token

# Admin security
ADMIN_API_KEY=your_admin_api_key_32_chars_minimum_change_this

# WAF Configuration
WAF_MODE=basic
WAF_PARANOIA_LEVEL=2

# =================================
# FEATURE FLAGS
# =================================
# Authentication features
FEATURE_REGISTRATION_ENABLED=true
FEATURE_EMAIL_VERIFICATION_REQUIRED=true
FEATURE_PASSWORD_RESET_ENABLED=true
FEATURE_SOCIAL_LOGIN_ENABLED=false

# Event features
FEATURE_EVENT_CREATION_ENABLED=true
FEATURE_EVENT_CATEGORIES_ENABLED=true
FEATURE_EVENT_TAGS_ENABLED=false
FEATURE_RECURRING_EVENTS_ENABLED=false

# Payment features
FEATURE_PAYMENT_ENABLED=true
FEATURE_PAYMENT_TEST_MODE=true

# Ticket features
FEATURE_QR_CODE_ENABLED=true
FEATURE_TICKET_TRANSFER_ENABLED=false
FEATURE_TICKET_RESALE_ENABLED=false

# Admin features
FEATURE_ADMIN_ENABLED=true
FEATURE_AUDIT_LOGS_ENABLED=true

# =================================
# FILE UPLOAD CONFIGURATION
# =================================
MAX_FILE_SIZE=5242880
UPLOAD_BASE_DIR=./public/uploads

# =================================
# CACHE & PERFORMANCE
# =================================
CACHE_ENABLED=true
CACHE_TTL=3600

# =================================
# DEVELOPMENT CONFIGURATION
# =================================
# Logging level (debug, info, warn, error)
LOG_LEVEL=info
MONITORING_LOGGING_ENABLED=true

# Frontend configuration
FRONTEND_URL=http://localhost:3000
DEFAULT_LOCALE=fr
SUPPORTED_LOCALES=fr,en
DEFAULT_TIMEZONE=Europe/Paris
DEFAULT_CURRENCY=EUR

# =================================
# NOTES FOR PRODUCTION
# =================================
# 1. Generate strong, unique secrets for production (use crypto.randomBytes(32).toString('hex'))
# 2. Use environment-specific database URLs with SSL
# 3. Enable HTTPS in production (update all URLs)
# 4. Configure proper CORS origins (remove localhost)
# 5. Set appropriate rate limits for production traffic
# 6. Enable all security features (HELMET, CSRF, WAF premium mode)
# 7. Use real Stripe live keys (not test keys)
# 8. Configure proper SMTP settings with real credentials
# 9. Set up Sentry for error monitoring
# 10. Review and adjust all feature flags
# 11. Use secure Redis configuration with password
# 12. Configure proper file upload limits and validation
# 13. Set up database backups and monitoring
# 14. Configure log aggregation and monitoring
# 15. Set NODE_ENV=production