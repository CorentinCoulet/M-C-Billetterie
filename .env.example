# ===================================================================
# FICHIER D'EXEMPLE - COPIER VERS .env.dev OU .env.prod
# Ne jamais commiter les vraies valeurs de production !
# ===================================================================
#
# Pour démarrer :
# 1. Copier ce fichier : cp .env.example .env.dev (ou .env.prod)
# 2. Modifier les valeurs selon votre environnement
# 3. Générer des secrets forts : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ===================================================================

# =================================
# ENVIRONNEMENT DOCKER COMPOSE
# =================================
# Pour dev: COMPOSE_ENV=dev, COMPOSE_NETWORK=billetterie-dev-network
# Pour prod: COMPOSE_ENV=prod, COMPOSE_NETWORK=billetterie-network
COMPOSE_ENV=dev
COMPOSE_NETWORK=billetterie-dev-network

# =================================
# DATABASE CONFIGURATION
# =================================
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_NAME=billetterie
DB_PORT=5432

# Database host (pour monitoring et connexion interne)
# Dev: db-dev | Prod: db
DB_HOST=db-dev

# Database URL
# Dev externe: postgresql://USER:PASS@localhost:5433/billetterie
# Dev interne Docker: postgresql://USER:PASS@db-dev:5432/billetterie
# Prod: postgresql://USER:PASS@db:5432/billetterie
DATABASE_URL=postgresql://postgres:CHANGE_THIS_PASSWORD@localhost:5433/billetterie

# =================================
# REDIS CONFIGURATION
# =================================
REDIS_PASSWORD=CHANGE_THIS_PASSWORD

# Redis host (pour monitoring et connexion interne)
# Dev: redis-dev | Prod: redis
REDIS_HOST=redis-dev

# Redis URL
# Dev externe: redis://:PASSWORD@localhost:6380
# Dev interne Docker: redis://:PASSWORD@redis-dev:6379
# Prod: redis://:PASSWORD@redis:6379
REDIS_URL=redis://:CHANGE_THIS_PASSWORD@localhost:6380

# =================================
# JWT & ENCRYPTION
# =================================
# ⚠️ CRITICAL: Tous les secrets doivent faire au moins 32 caractères !
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_RANDOM_32_CHARS_MINIMUM
JWT_REFRESH_SECRET=CHANGE_THIS_TO_RANDOM_32_CHARS_MINIMUM
ENCRYPTION_KEY=CHANGE_THIS_TO_RANDOM_32_CHARS
AES_SECRET=CHANGE_THIS_TO_RANDOM_32_CHARS
DATA_ENCRYPTION_KEY=CHANGE_THIS_TO_RANDOM_32_CHARS
SESSION_SECRET=CHANGE_THIS_TO_RANDOM_32_CHARS
QR_ROTATION_SECRET=CHANGE_THIS_TO_RANDOM_32_CHARS

# =================================
# SERVER CONFIGURATION
# =================================
# Dev: 3001 | Prod: 3000
PORT=3001
# Dev: development | Prod: production
NODE_ENV=development
# Dev: http://localhost:3001 | Prod: https://yourdomain.com
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# =================================
# SECURITY
# =================================
SECURITY_HELMET_ENABLED=true
SECURITY_CORS_ENABLED=true
# Dev: false | Prod: true
SECURITY_RATE_LIMIT_ENABLED=false

# =================================
# FEATURES
# =================================
FEATURE_AUTH_ENABLED=true
FEATURE_EVENTS_ENABLED=true
# Dev: false | Prod: true
FEATURE_PAYMENTS_ENABLED=false
FEATURE_EMAIL_ENABLED=true

# =================================
# EMAIL CONFIGURATION
# =================================
EMAIL_FROM=noreply@yourdomain.com
CONTACT_EMAIL=contact@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# =================================
# MONITORING
# =================================
MONITORING_LOGGING_ENABLED=true
# Dev: true | Prod: false
DEBUG=true
VERBOSE_LOGGING=true

# =================================
# FILE UPLOAD
# =================================
UPLOAD_BASE_DIR=./uploads
# Dev: 5MB | Prod: 10MB
MAX_FILE_SIZE=5242880

# =================================
# CACHE & PERFORMANCE
# =================================
CACHE_ENABLED=true
# Dev: 3600 | Prod: 7200
CACHE_TTL=3600

# =================================
# RATE LIMITING
# =================================
RATE_LIMIT_WINDOW_MS=900000
# Dev: 1000 | Prod: 100
RATE_LIMIT_MAX_REQUESTS=1000

# =================================
# SEED DATA - TEST ACCOUNTS
# =================================
# Dev: testing password | Prod: do not use it
SEED_ADMIN_PASSWORD=Admin123!Dev
SEED_ORGANIZER_PASSWORD=Organizer123!Dev
SEED_USER_PASSWORD=User123!Dev

# =================================
# DATABASE ADMINISTRATION
# =================================
ADMINER_PORT=8080
ADMINER_DESIGN=pepa-linha-dark

# =================================
# MONITORING & OBSERVABILITY
# =================================
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_RELEASE=billetterie@1.0.0
# Dev: development | Prod: production
SENTRY_ENVIRONMENT=development
# Dev: true | Prod: false
SENTRY_DEBUG=false

# =================================
# MONITORING PORTS
# =================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121
NODE_EXPORTER_PORT=9100
ALERTMANAGER_PORT=9093

# =================================
# GRAFANA CREDENTIALS
# =================================
GRAFANA_ADMIN_USER=admin
# Dev: admin123 | Prod: STRONG_PASSWORD
GRAFANA_ADMIN_PASSWORD=admin123