# =================================
# CORE CONFIGURATION
# =================================
NODE_ENV=development
PORT=3001

# =================================
# DATABASE CONFIGURATION
# =================================
DATABASE_URL=postgresql://user:password@localhost:5432/billetterie_db

# =================================
# AUTHENTICATION & SECURITY
# =================================
JWT_SECRET=your_super_secure_jwt_secret_key_32_chars_min
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=your_super_secure_encryption_key_32_chars
SESSION_SECRET=your_session_secret_key
BCRYPT_SALT_ROUNDS=12
MFA_SECRET=your_mfa_secret

# =================================
# STRIPE PAYMENT (Optional)
# =================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=eur

# Stripe API Configuration
STRIPE_API_VERSION=2025-06-30.basil
STRIPE_DEFAULT_API_VERSION=2025-06-30.basil
STRIPE_SUPPORTED_VERSIONS=2025-06-30.basil,2024-06-20,2024-04-10,2024-02-15,2023-10-16

# Stripe Currencies
STRIPE_DEFAULT_CURRENCY=EUR
STRIPE_SUPPORTED_CURRENCIES=EUR,USD,GBP

# Stripe Webhook & Cache Settings
STRIPE_WEBHOOK_TOLERANCE=300
STRIPE_MAX_RETRIES=3
STRIPE_RETRY_DELAY=1000
STRIPE_MAX_PROCESSED_EVENTS=1000
STRIPE_CACHE_CLEANUP_SIZE=500
STRIPE_CACHE_CLEANUP_INTERVAL=3600000

# =================================
# EMAIL CONFIGURATION (Optional)
# =================================
EMAIL_FROM=noreply@billetterie.com
CONTACT_EMAIL=contact@billetterie.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# =================================
# URLS
# =================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =================================
# FEATURE FLAGS
# =================================
FEATURE_AUTH_ENABLED=true
FEATURE_PAYMENTS_ENABLED=true
FEATURE_EMAIL_ENABLED=true

# =================================
# FILE UPLOAD
# =================================
UPLOAD_BASE_DIR=./public/uploads
MAX_FILE_SIZE=5242880

# =================================
# CACHE & PERFORMANCE
# =================================
CACHE_ENABLED=true
CACHE_TTL=3600

# =================================
# RATE LIMITING
# =================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =================================
# MONITORING & OBSERVABILITY
# =================================
# Sentry Error Tracking (Required for production)
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_RELEASE=billetterie@1.0.0
SENTRY_ENVIRONMENT=production
SENTRY_DEBUG=false

# Prometheus/Grafana (Optional but recommended)
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password

# =================================
# SECURITY FLAGS
# =================================
HELMET_ENABLED=true
CORS_ENABLED=true