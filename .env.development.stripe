# Configuration Stripe for Développement
# Copy this file to .env.development

# =================================
# STRIPE API CONFIGURATION
# =================================
STRIPE_API_VERSION=2024-06-20
STRIPE_DEFAULT_API_VERSION=2024-06-20
STRIPE_SUPPORTED_VERSIONS=2024-06-20,2024-04-10,2024-02-15

# =================================
# CURRENCY CONFIGURATION
# =================================
STRIPE_DEFAULT_CURRENCY=EUR
STRIPE_SUPPORTED_CURRENCIES=EUR,USD

# =================================
# WEBHOOK & PERFORMANCE SETTINGS (Dev optimized)
# =================================
STRIPE_WEBHOOK_TOLERANCE=300
STRIPE_MAX_RETRIES=2
STRIPE_RETRY_DELAY=500
STRIPE_MAX_PROCESSED_EVENTS=100
STRIPE_CACHE_CLEANUP_SIZE=50
STRIPE_CACHE_CLEANUP_INTERVAL=1800000  # 30 minutes
