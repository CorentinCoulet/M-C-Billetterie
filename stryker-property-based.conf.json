{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "yarn",
  "testRunner": "jest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "tests/property-based/**/*.test.ts"
  ],
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.js",
    "enableFindRelatedTests": true
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "timeoutMS": 300000,
  "concurrency": 2,
  "reporters": ["html", "clear-text", "progress", "json"],
  "htmlReporter": {
    "fileName": "coverage/mutation-property-based/index.html"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation-property-based/mutation.json"
  },
  "checkers": [],
  "ignorePatterns": [
    "node_modules",
    "coverage",
    "dist",
    ".next"
  ],
  "ignoreStatic": true,
  "disableTypeChecks": true
}
