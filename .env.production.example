# Production Environment Variables
# ⚠️ NEVER commit real values to git
# Copy to .env.production and configure with your actual values

# === Application ===
NODE_ENV=production
APP_URL=https://tickets.company.com
PORT=3000
LOG_LEVEL=warn
DEBUG=false

# === Database ===
DATABASE_URL=postgresql://username:password@host:5432/billetterie?sslmode=require
DATABASE_REPLICA_URL=postgresql://username:password@replica-host:5432/billetterie?sslmode=require
DATABASE_POOL_SIZE=20
DATABASE_SSL=true

# === Redis (for rate limiting and caching) ===
REDIS_URL=redis://username:password@host:6379
REDIS_POOL_SIZE=10
REDIS_SSL=true

# === Authentication ===
JWT_SECRET=""  # Will be managed by secrets manager
JWT_REFRESH_SECRET=""  # Will be managed by secrets manager
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=""  # Will be managed by secrets manager

# === Payment (Stripe) ===
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=""  # Will be managed by secrets manager
STRIPE_WEBHOOK_SECRET=""  # Will be managed by secrets manager

# === Email ===
EMAIL_HOST=smtp.company.com
EMAIL_PORT=587
EMAIL_SECURE=true
EMAIL_USER=noreply@company.com
EMAIL_PASSWORD=""  # Will be managed by secrets manager
EMAIL_SERVICE_API_KEY=""  # Will be managed by secrets manager

# === SSL/TLS ===
SSL_CERT_PATH=/app/ssl/server.crt
SSL_KEY_PATH=/app/ssl/server.key
SSL_CA_PATH=/app/ssl/ca.crt
FORCE_HTTPS=true

# === Secrets Management ===
# Choose ONE provider:

# Azure Key Vault
AZURE_KEY_VAULT_URL=https://your-keyvault.vault.azure.net/
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-tenant-id

# OR AWS Secrets Manager
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1

# OR HashiCorp Vault
VAULT_TOKEN=your-vault-token
VAULT_ENDPOINT=https://vault.company.com:8200

# === Security ===
ENCRYPTION_KEY=""  # Will be managed by secrets manager
BACKUP_ENCRYPTION_KEY=""  # Will be managed by secrets manager
RATE_LIMIT_WHITELIST=127.0.0.1,10.0.0.0/8
AUTO_ROTATE_SECRETS=true
AUTO_GENERATE_SECRETS=false  # Should be false in production

# === Monitoring ===
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEW_RELIC_LICENSE_KEY=your-key-here
PROMETHEUS_PORT=9090
HEALTH_CHECK_PORT=9000

# === Performance ===
CDN_URL=https://cdn.company.com
CACHE_TTL=3600
MAX_FILE_SIZE=10485760  # 10MB

# === Domain Configuration ===
DOMAIN=tickets.company.com
API_DOMAIN=api.tickets.company.com
ADMIN_DOMAIN=admin.tickets.company.com
ADMIN_EMAIL=admin@company.com

# === Backup ===
BACKUP_BUCKET=s3://company-billetterie-backups
BACKUP_RETENTION_DAYS=90

# === Logging ===
LOG_RETENTION_DAYS=30
LOG_FORMAT=json
LOG_DESTINATION=file,console
ENABLE_REQUEST_LOGGING=false

# === Feature Flags ===
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_MULTI_LANGUAGE=true
FEATURE_QR_CODES=true
FEATURE_SOCIAL_LOGIN=true
