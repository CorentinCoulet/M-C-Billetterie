<!-- Organization Invitation Email Template -->
<div style="max-width: 600px; margin: 0 auto; padding: 20px; font-family: Arial, sans-serif;">
  <!-- Header -->
  <div style="text-align: center; margin-bottom: 30px;">
    <h1 style="color: #2563eb; margin: 0;">🎉 Vous êtes invité(e) !</h1>
    <p style="color: #6b7280; font-size: 16px; margin-top: 10px;">
      Rejoignez {{organizationName}} sur {{appName}}
    </p>
  </div>

  <!-- Invitation Card -->
  <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 12px; padding: 30px; color: white; margin-bottom: 30px; text-align: center;">
    <p style="font-size: 18px; margin: 0 0 20px 0; opacity: 0.9;">
      <strong>{{inviterName}}</strong> vous a invité(e) à rejoindre
    </p>
    <h2 style="font-size: 32px; margin: 0 0 20px 0; font-weight: bold;">
      {{organizationName}}
    </h2>
    <div style="background: rgba(255, 255, 255, 0.2); border-radius: 8px; padding: 15px; display: inline-block;">
      <p style="margin: 0; font-size: 14px; opacity: 0.8;">Votre rôle sera</p>
      <p style="margin: 5px 0 0 0; font-size: 20px; font-weight: bold; text-transform: uppercase;">
        {{role}}
      </p>
    </div>
  </div>

  <!-- Message -->
  <div style="margin-bottom: 30px;">
    <p style="font-size: 16px; color: #374151; line-height: 1.6;">
      Bonjour ! 👋
    </p>
    <p style="font-size: 16px; color: #374151; line-height: 1.6;">
      <strong>{{inviterName}}</strong> pense que vous seriez un excellent ajout à son équipe chez <strong>{{organizationName}}</strong>.
      En rejoignant, vous pourrez collaborer sur des événements, gérer des billets et contribuer à créer des expériences exceptionnelles.
    </p>
  </div>

  <!-- Role Permissions Info -->
  <div style="background: #f3f4f6; border-radius: 8px; padding: 20px; margin-bottom: 30px;">
    <h3 style="margin: 0 0 15px 0; font-size: 16px; color: #374151;">👤 À propos du rôle {{role}}</h3>
    <p style="margin: 0; font-size: 14px; color: #6b7280; line-height: 1.6;">
      {{#if (eq role "OWNER")}}
        En tant que Propriétaire, vous aurez un contrôle total sur l'organisation, incluant la gestion des membres, des événements et des paramètres.
      {{else if (eq role "ADMIN")}}
        En tant qu'Administrateur, vous pourrez gérer les événements, traiter les billets et superviser les activités de l'organisation.
      {{else if (eq role "MANAGER")}}
        En tant que Manager, vous pourrez créer et gérer des événements, et coordonner avec les membres de l'équipe.
      {{else if (eq role "MEMBER")}}
        En tant que Membre, vous pourrez contribuer aux événements et aider aux opérations quotidiennes.
      {{else}}
        En tant qu'Observateur, vous aurez un accès en lecture seule pour consulter les événements et activités de l'organisation.
      {{/if}}
    </p>
  </div>

  <!-- Action Buttons -->
  <div style="text-align: center; margin-bottom: 30px;">
    <a href="{{acceptUrl}}" style="display: inline-block; background: #10b981; color: white; padding: 14px 32px; text-decoration: none; border-radius: 8px; font-weight: bold; font-size: 16px; margin: 0 10px 10px 0;">
      ✅ Accepter l'invitation
    </a>
    <a href="{{declineUrl}}" style="display: inline-block; background: #6b7280; color: white; padding: 14px 32px; text-decoration: none; border-radius: 8px; font-weight: bold; font-size: 16px; margin: 0 0 10px 0;">
      ❌ Décliner
    </a>
  </div>

  <!-- Expiration Notice -->
  <div style="background: #fef3c7; border-left: 4px solid #f59e0b; padding: 15px; border-radius: 8px; margin-bottom: 30px;">
    <p style="margin: 0; font-size: 14px; color: #92400e; font-weight: bold;">
      ⏰ Invitation à durée limitée
    </p>
    <p style="margin: 10px 0 0 0; font-size: 14px; color: #92400e; line-height: 1.5;">
      Cette invitation expirera le <strong>{{expirationDate}}</strong> (dans {{validityDays}} jours).
      Assurez-vous d'accepter avant cette date !
    </p>
  </div>

  <!-- What's Next -->
  <div style="background: #eff6ff; border-radius: 8px; padding: 20px; margin-bottom: 30px;">
    <h3 style="margin: 0 0 15px 0; font-size: 16px; color: #1e40af;">🚀 Quelle est la suite ?</h3>
    <ol style="margin: 0; padding-left: 20px; color: #1e40af; font-size: 14px; line-height: 1.8;">
      <li>Cliquez sur "Accepter l'invitation" ci-dessus</li>
      <li>Vous serez redirigé(e) vers {{appName}}</li>
      <li>Complétez votre profil (si nécessaire)</li>
      <li>Commencez à collaborer avec votre équipe !</li>
    </ol>
  </div>

  <!-- Alternative Link -->
  <div style="background: #f9fafb; border-radius: 8px; padding: 15px; margin-bottom: 30px;">
    <p style="margin: 0 0 10px 0; font-size: 14px; color: #6b7280;">
      Si les boutons ne fonctionnent pas, copiez et collez ce lien dans votre navigateur :
    </p>
    <p style="margin: 0; font-size: 12px; color: #2563eb; word-break: break-all;">
      {{acceptUrl}}
    </p>
  </div>

  <!-- Questions Section -->
  <div style="text-align: center; margin-bottom: 30px;">
    <p style="font-size: 14px; color: #6b7280; margin-bottom: 15px;">
      Des questions sur cette invitation ?
    </p>
    <a href="{{organizationsUrl}}" style="color: #2563eb; text-decoration: none; font-size: 14px; font-weight: bold;">
      En savoir plus sur les Organisations →
    </a>
  </div>

  <!-- Footer -->
  <div style="text-align: center; padding-top: 20px; border-top: 1px solid #e5e7eb;">
    <p style="font-size: 14px; color: #6b7280; margin-bottom: 10px;">
      Cette invitation a été envoyée à <strong>{{recipientEmail}}</strong>
    </p>
    <p style="font-size: 12px; color: #9ca3af; margin-bottom: 10px;">
      Si vous n'attendiez pas cette invitation, vous pouvez ignorer cet email en toute sécurité.
    </p>
    <p style="font-size: 12px; color: #9ca3af;">
      © {{currentYear}} {{appName}}. Tous droits réservés.
    </p>
  </div>
</div>
