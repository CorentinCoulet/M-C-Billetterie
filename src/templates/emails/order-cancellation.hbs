<!-- Order Cancellation Email Template -->
<div style="max-width: 600px; margin: 0 auto; padding: 20px; font-family: Arial, sans-serif;">
  <!-- Header -->
  <div style="text-align: center; margin-bottom: 30px;">
    <h1 style="color: #dc2626; margin: 0;">❌ Commande Annulée</h1>
    <p style="color: #6b7280; font-size: 16px; margin-top: 10px;">
      Commande #{{orderId}}
    </p>
  </div>

  <!-- Greeting -->
  <div style="margin-bottom: 30px;">
    <p style="font-size: 16px; color: #374151;">
      Bonjour <strong>{{customerName}}</strong>,
    </p>
    <p style="font-size: 16px; color: #374151; line-height: 1.6;">
      Nous vous écrivons pour confirmer que votre commande a été annulée comme demandé.
    </p>
  </div>

  <!-- Cancellation Details Card -->
  <div style="background: #fee2e2; border-left: 4px solid #dc2626; border-radius: 8px; padding: 20px; margin-bottom: 30px;">
    <h3 style="margin: 0 0 15px 0; font-size: 16px; color: #7f1d1d;">📋 Détails de l'annulation</h3>
    <div style="margin-bottom: 10px;">
      <p style="margin: 0; font-size: 14px; color: #991b1b;">
        <strong>N° de commande :</strong> {{orderId}}
      </p>
    </div>
    <div style="margin-bottom: 10px;">
      <p style="margin: 0; font-size: 14px; color: #991b1b;">
        <strong>Date d'annulation :</strong> {{formatDate cancellationDate}}
      </p>
    </div>
    <div style="margin-bottom: 10px;">
      <p style="margin: 0; font-size: 14px; color: #991b1b;">
        <strong>Raison :</strong> {{cancellationReason}}
      </p>
    </div>
  </div>

  <!-- Order Summary -->
  <div style="background: #f9fafb; border-radius: 8px; padding: 20px; margin-bottom: 30px;">
    <h3 style="margin: 0 0 15px 0; font-size: 16px; color: #374151;">📦 Articles annulés</h3>
    
    {{#each tickets}}
      <div style="background: white; border-radius: 8px; padding: 15px; margin-bottom: 15px; border: 1px solid #e5e7eb;">
        <p style="margin: 0 0 5px 0; font-size: 16px; color: #111827; font-weight: bold;">
          {{this.eventName}}
        </p>
        <p style="margin: 0 0 5px 0; font-size: 14px; color: #6b7280;">
          {{this.name}} × {{this.quantity}}
        </p>
        <p style="margin: 0; font-size: 14px; color: #6b7280;">
          📅 {{formatDate this.eventDate}}
        </p>
      </div>
    {{/each}}

    <!-- Totals -->
    <div style="border-top: 2px solid #e5e7eb; padding-top: 15px; margin-top: 15px;">
      <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
        <p style="margin: 0; font-size: 14px; color: #6b7280;">Total de la commande :</p>
        <p style="margin: 0; font-size: 14px; color: #6b7280; font-weight: bold;">
          {{formatCurrency totalAmount}}
        </p>
      </div>
      <div style="display: flex; justify-content: space-between;">
        <p style="margin: 0; font-size: 16px; color: #10b981; font-weight: bold;">Montant du remboursement :</p>
        <p style="margin: 0; font-size: 16px; color: #10b981; font-weight: bold;">
          {{formatCurrency refundAmount}}
        </p>
      </div>
    </div>
  </div>

  <!-- Refund Information -->
  <div style="background: #d1fae5; border-left: 4px solid #10b981; border-radius: 8px; padding: 20px; margin-bottom: 30px;">
    <h3 style="margin: 0 0 15px 0; font-size: 16px; color: #065f46;">💰 Informations de remboursement</h3>
    <p style="margin: 0 0 10px 0; font-size: 14px; color: #065f46; line-height: 1.6;">
      Votre remboursement de <strong>{{formatCurrency refundAmount}}</strong> est en cours de traitement et sera crédité sur votre moyen de paiement d'origine.
    </p>
    <div style="background: rgba(16, 185, 129, 0.1); border-radius: 6px; padding: 12px; margin-top: 15px;">
      <p style="margin: 0; font-size: 14px; color: #065f46;">
        ⏱️ <strong>Délai de traitement :</strong> {{refundProcessingDays}} jours ouvrés
      </p>
    </div>
  </div>

  <!-- Important Notes -->
  <div style="background: #fef3c7; border-left: 4px solid #f59e0b; border-radius: 8px; padding: 15px; margin-bottom: 30px;">
    <p style="margin: 0; font-size: 14px; color: #92400e; font-weight: bold;">
      ⚠️ Notes importantes
    </p>
    <ul style="margin: 10px 0 0 0; padding-left: 20px; color: #92400e; font-size: 14px; line-height: 1.6;">
      <li>Vos billets ont été invalidés et ne peuvent plus être utilisés</li>
      <li>Vous recevrez un email séparé lorsque le remboursement sera finalisé</li>
      <li>Le remboursement peut prendre du temps supplémentaire pour apparaître sur votre compte selon votre banque</li>
      <li>Les codes promotionnels utilisés ne peuvent pas être réutilisés</li>
    </ul>
  </div>

  <!-- Order Information -->
  <div style="background: #f3f4f6; border-radius: 8px; padding: 20px; margin-bottom: 30px;">
    <h3 style="margin: 0 0 15px 0; font-size: 16px; color: #374151;">📊 Informations de commande</h3>
    <div style="margin-bottom: 8px;">
      <p style="margin: 0; font-size: 14px; color: #6b7280;">
        <strong>Date de commande :</strong> {{formatDate orderDate}}
      </p>
    </div>
    <div style="margin-bottom: 8px;">
      <p style="margin: 0; font-size: 14px; color: #6b7280;">
        <strong>Email du client :</strong> {{customerEmail}}
      </p>
    </div>
    <div>
      <p style="margin: 0; font-size: 14px; color: #6b7280;">
        <strong>Date d'annulation :</strong> {{formatDate cancellationDate}}
      </p>
    </div>
  </div>

  <!-- Actions -->
  <div style="text-align: center; margin-bottom: 30px;">
    <a href="{{ordersUrl}}" style="display: inline-block; background: #2563eb; color: white; padding: 14px 32px; text-decoration: none; border-radius: 8px; font-weight: bold; font-size: 16px; margin: 0 5px 10px 5px;">
      Voir l'historique des commandes
    </a>
    <a href="{{helpUrl}}" style="display: inline-block; background: #6b7280; color: white; padding: 14px 32px; text-decoration: none; border-radius: 8px; font-weight: bold; font-size: 16px; margin: 0 5px 10px 5px;">
      Obtenir de l'aide
    </a>
  </div>

  <!-- We're Sorry -->
  <div style="background: white; border: 1px solid #e5e7eb; border-radius: 8px; padding: 20px; margin-bottom: 30px; text-align: center;">
    <p style="font-size: 16px; color: #374151; margin: 0 0 15px 0;">
      😊 Nous sommes désolés de voir que vous annulez cette commande.
    </p>
    <p style="font-size: 14px; color: #6b7280; margin: 0; line-height: 1.6;">
      Nous espérons vous servir à nouveau dans le futur ! Découvrez nos prochains événements et trouvez quelque chose d'excitant.
    </p>
    <a href="{{baseUrl}}/events" style="display: inline-block; margin-top: 15px; color: #2563eb; text-decoration: none; font-weight: bold;">
      Parcourir les événements →
    </a>
  </div>

  <!-- Footer -->
  <div style="text-align: center; padding-top: 20px; border-top: 1px solid #e5e7eb;">
    <p style="font-size: 14px; color: #6b7280; margin-bottom: 10px;">
      Des questions sur votre annulation ?
    </p>
    <p style="font-size: 14px; color: #6b7280; margin-bottom: 15px;">
      Contactez-nous à <a href="mailto:{{supportEmail}}" style="color: #2563eb;">{{supportEmail}}</a>
    </p>
    <p style="font-size: 12px; color: #9ca3af;">
      © {{currentYear}} {{appName}}. Tous droits réservés.
    </p>
  </div>
</div>
