# =================================
# PRODUCTION CONFIGURATION
# =================================
NODE_ENV=production
PORT=3000

# =================================
# DATABASE CONFIGURATION (Production)
# =================================
DB_USER=postgres
DB_PASSWORD=super_secure_production_password_123
DB_NAME=billetterie
DB_PORT=5432
DATABASE_URL=postgresql://postgres:super_secure_production_password_123@postgres:5432/billetterie

# =================================
# REDIS CONFIGURATION (Production)
# =================================
REDIS_PASSWORD=super_secure_redis_password_456
REDIS_PORT=6379
REDIS_URL=redis://:super_secure_redis_password_456@redis:6379

# =================================
# AUTHENTICATION & SECURITY (Production)
# =================================
JWT_SECRET=production_jwt_secret_key_32_chars_long_very_secure_123456789
JWT_REFRESH_SECRET=production_refresh_secret_key_32_chars_long_secure_abcdef
ENCRYPTION_KEY=production_encryption_key_32_chars_long_secure_1234567890
AES_SECRET=production_aes_secret_key_32_chars_long_secure_abcdef123456
DATA_ENCRYPTION_KEY=production_data_encryption_key_32_chars_secure_xyz789
SESSION_SECRET=production_session_secret_key_32_chars_secure_session_abc
QR_ROTATION_SECRET=production_qr_rotation_secret_32_chars_secure_qr_key123

# =================================
# SSL & DOMAIN (Production)
# =================================
DOMAIN=billetterie.example.com
SSL_EMAIL=admin@billetterie.example.com
NEXT_PUBLIC_APP_URL=https://billetterie.example.com

# =================================
# STRIPE PAYMENT (Production)
# =================================
STRIPE_SECRET_KEY=sk_live_your_production_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_production_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret
STRIPE_CURRENCY=eur

# =================================
# EMAIL CONFIGURATION (Production)
# =================================
EMAIL_FROM=noreply@billetterie.example.com
CONTACT_EMAIL=contact@billetterie.example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_production_email@gmail.com
SMTP_PASS=your_production_email_password

# =================================
# FEATURES (Production)
# =================================
FEATURE_AUTH_ENABLED=true
FEATURE_EVENTS_ENABLED=true
FEATURE_PAYMENTS_ENABLED=true
FEATURE_EMAIL_ENABLED=true

# =================================
# SECURITY SETTINGS (Production)
# =================================
SECURITY_HELMET_ENABLED=true
SECURITY_CORS_ENABLED=true
SECURITY_RATE_LIMIT_ENABLED=true

# =================================
# MONITORING (Production)
# =================================
GRAFANA_ADMIN_PASSWORD=super_secure_grafana_password_789
PROMETHEUS_ENABLED=true
MONITORING_LOGGING_ENABLED=true
LOG_LEVEL=warn

# =================================
# BACKUP (Production)
# =================================
BACKUP_ENCRYPTION_KEY=backup_encryption_key_32_chars_long_secure_backup123
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# =================================
# SENTRY (Production)
# =================================
NEXT_PUBLIC_SENTRY_DSN=https://your-production-dsn@sentry.io/project-id
SENTRY_RELEASE=billetterie@1.2.0
SENTRY_ENVIRONMENT=production
SENTRY_DEBUG=false

# =================================
# PERFORMANCE (Production)
# =================================
CACHE_ENABLED=true
CACHE_TTL=3600

# =================================
# RATE LIMITING (Production)
# =================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =================================
# FILE UPLOAD (Production)
# =================================
UPLOAD_BASE_DIR=./uploads
MAX_FILE_SIZE=5242880